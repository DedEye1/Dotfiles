layout {

    focus-ring {
        active-color   "#a4d1b3"
        inactive-color "#121412"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a4d1b3"
        inactive-color "#121412"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a4d1b3"
        inactive-color "#04311d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a4d1b380"
    }
}

recent-windows {
    highlight {
        active-color "#a4d1b3"
        urgent-color "#ffb4ab"
    }
}
